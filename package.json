{
  "name": "rokit-automatic-path-planner",
  "version": "1.0.0",
  "description": "Med Robots PharmaRobot navigation control and footprint-aware VDA 5050 path planner",
  "author": "Med Robots",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "stage5b": "tsx src/tools/stage5B.ts",
    "stage5b:collect": "tsx src/tools/stage5BCollect.ts",
    "dev": "concurrently -k \"npm:server:dev\" \"npm:vite:dev\"",
    "vite:dev": "vite",
    "server:dev": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && npm run server:build && npm run electron:compile",
    "build:docker": "tsc -b && vite build && npm run server:build",
    "server:build": "tsc -p server/tsconfig.json",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "start:prod": "node dist-electron/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "electron:dev": "npm run electron:compile && concurrently -k \"npm:server:dev\" \"npm:vite:dev\" \"wait-on tcp:5173 tcp:8787 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mqtt": "^5.14.1",
    "ws": "^8.18.3",
    "yaml": "^2.8.0",
    "zod": "^4.0.10",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "pt.medrobots.navigation-control",
    "productName": "Med Robots Navigation Control",
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "win": {"target": "nsis"},
    "directories": {"output": "release"}
  }
}
